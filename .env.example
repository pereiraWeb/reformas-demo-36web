# Copy this file to `.env` (local dev) or set these as Environment Variables
# in your Vercel project (Production/Preview) to enable real email delivery
# for the contact form (`src/pages/api/contact.ts` -> `src/lib/email.ts`).
#
# RESEND_API_KEY is REQUIRED in production: if it's missing, the contact form
# will fail to send (never a fake "success") and the error is logged on the
# server, without any personal data. In local development only, submissions
# are simulated (logged, no email sent) when this key is not set.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Full "from" sender, exactly as Resend expects it — used as-is, so include
# the display name yourself if you want one. Must use an address verified in
# your Resend domain (https://resend.com/domains). Required in production;
# in development only, a clearly-labelled test address is used if left empty.
CONTACT_FROM_EMAIL=Mi Empresa <formularios@empresa.es>

# Inbox that receives contact form submissions. Defaults to `business.email`
# from `src/config/business.ts` when not set.
CONTACT_TO_EMAIL=info@empresa.es

# The contact endpoint already has a honeypot field and best-effort IP rate
# limiting (see src/pages/api/contact.ts and src/lib/rateLimit.ts — note the
# rate limit is NOT persistent on serverless platforms like Vercel). Only add
# a CAPTCHA on top of those if spam still gets through in practice — e.g.
# Cloudflare Turnstile:
# 1. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# 2. Render the widget in ContactForm and send its token as a `cf-turnstile-response` field
# 3. Verify it server-side in src/pages/api/contact.ts against the secret below
#    before calling sendContactEmail (POST to https://challenges.cloudflare.com/turnstile/v0/siteverify)
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analytics & ads (all optional) — read in src/config/integrations.ts,
# consumed by src/lib/analytics.ts
# ---------------------------------------------------------------------------
# All variables below MUST use the `PUBLIC_` prefix: Astro/Vite only exposes
# `PUBLIC_*` variables to browser code, and these are read client-side to
# load the corresponding script (see
# https://docs.astro.build/en/guides/environment-variables/). Leave any of
# them empty to simply not load that integration — never hardcode a real
# client's ID inside this starter's source code.
#
# None of these scripts load until the visitor explicitly grants the
# relevant cookie consent category (see src/lib/consent.ts): Google
# Analytics needs "analytics" consent; Google Ads and Meta Pixel need
# "marketing" consent. They also never load during `astro dev` or
# `astro preview` unless PUBLIC_ANALYTICS_DEBUG=true, so local development
# never pollutes real analytics/ads data.

# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
# (Admin -> Data Streams -> your stream, in https://analytics.google.com)
PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID, e.g. "AW-XXXXXXXXX"
# (Tools -> Conversions -> your conversion action, in https://ads.google.com)
PUBLIC_GOOGLE_ADS_ID=

# Meta (Facebook/Instagram) Pixel ID
# (Events Manager -> your pixel, in https://business.facebook.com/events_manager)
PUBLIC_META_PIXEL_ID=

# Set to "true" to force-enable the scripts above during `astro dev`/`astro
# preview`, e.g. to test the integrations themselves locally. Leave unset
# in normal day-to-day development.
# PUBLIC_ANALYTICS_DEBUG=true

# ---------------------------------------------------------------------------
# Demos gallery (optional)
# ---------------------------------------------------------------------------
# The `/demos` pages (and the "Demos" nav item) are available during
# `astro dev` and excluded from production builds by default, so unused
# component variants never ship in the live bundle. Set this to keep them
# in a build — e.g. a staging deploy that still needs the gallery:
# INCLUDE_DEMOS=true

# ---------------------------------------------------------------------------
# Maps (optional) — read in src/config/integrations.ts, used by
# src/components/media/MapEmbed.astro (shown on the contact page)
# ---------------------------------------------------------------------------
# Optional: without it, MapEmbed still works via a free, keyless Google Maps
# embed. Set this to use the official Google Maps Embed API instead:
# 1. Create/select a project at https://console.cloud.google.com
# 2. Enable the "Maps Embed API" for that project
# 3. Create an API key (APIs & Services -> Credentials) and restrict it to
#    the "Maps Embed API" and to your production domain (HTTP referrers)
# PUBLIC_GOOGLE_MAPS_API_KEY=
