---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BusinessLayout title="Página no encontrada" description="La página que buscas no existe o se ha movido." noindex>
	<section class="not-found">
		<Container narrow class="not-found__inner">
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1>Página no encontrada</h1>
			<p>La página que buscas no existe, se ha movido o la dirección tiene un error.</p>
			<Button href="/">Volver al inicio</Button>
		</Container>
	</section>
</BusinessLayout>

<style>
	.not-found {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 60vh;
		text-align: center;
	}

	:global(.not-found__inner) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.not-found__code {
		margin: 0;
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 700;
		line-height: 1;
		color: var(--color-primary);
	}

	.not-found p:not(.not-found__code) {
		max-width: 480px;
		color: var(--color-text-muted);
	}
</style>
