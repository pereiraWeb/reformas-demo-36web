---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { thankYouContent } from '../config/formContent';

// A dedicated, measurable destination URL: point analytics/ads conversion
// goals at `/thank-you` to track successful contact form submissions.
// `ContactForm` redirects here automatically after a successful send.
---

<BusinessLayout title={thankYouContent.title} description={thankYouContent.description} noindex>
	<section class="thank-you">
		<Container narrow class="thank-you__inner">
			<span class="thank-you__icon" aria-hidden="true">
				<Icon name="check" size={32} />
			</span>
			<h1>{thankYouContent.title}</h1>
			<p>{thankYouContent.description}</p>
			<Button href={thankYouContent.backHref}>{thankYouContent.backText}</Button>
		</Container>
	</section>
</BusinessLayout>

<style>
	.thank-you {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 60vh;
		text-align: center;
	}

	:global(.thank-you__inner) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.thank-you__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		margin-bottom: var(--spacing-xs);
		border-radius: 50%;
		background-color: color-mix(in srgb, var(--color-primary) 15%, transparent);
		color: var(--color-primary);
	}

	.thank-you p {
		max-width: 480px;
		color: var(--color-text-muted);
	}
</style>
