---
import SectorDemoPage from '../../components/sector-demo/SectorDemoPage.astro';
import { buildReparacionesDemo } from '../../config/localDemos/reparaciones';

/**
 * On demand. The city name is read from the URL segment, so
 * `/reparaciones/getafe` is Getafe without adding it to a list.
 * `noindex, nofollow` come from the shared layout. The route is not
 * prerendered, so it stays out of the sitemap.
 */
export const prerender = false;

const city = typeof Astro.params.city === 'string' ? Astro.params.city : '';
const { demo, pagePath } = buildReparacionesDemo(city);
---

<SectorDemoPage demo={demo} pagePath={pagePath} />
