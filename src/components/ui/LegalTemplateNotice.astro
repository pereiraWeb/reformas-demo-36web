---
import { legalTemplateNotice } from '../../config/legalContent';

export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['legal-template-notice', className]} role="note">
	<p class="legal-template-notice__title">⚠️ {legalTemplateNotice.title}</p>
	<p class="legal-template-notice__message">{legalTemplateNotice.message}</p>
</div>

<style>
	.legal-template-notice {
		margin-bottom: var(--spacing-md);
		padding: var(--spacing-sm) var(--spacing-md);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-primary);
		border-radius: var(--radius-base);
		background-color: var(--color-surface);
	}

	.legal-template-notice__title {
		margin: 0 0 0.25rem;
		font-weight: 700;
	}

	.legal-template-notice__message {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}
</style>
