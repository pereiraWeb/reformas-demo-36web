---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import IconLinks, { type IconLinkItem } from '../ui/IconLinks.astro';
import BrandMark from '../ui/BrandMark.astro';
import { business } from '../../config/business';
import { mainNavigation } from '../../config/navigation';
import { headerContent } from '../../config/headerContent';
import { getHeaderIconLinks } from '../../lib/iconLinks';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';
import NavMenu from './NavMenu.astro';

export interface Props extends BackgroundProps {
	ctaText?: string;
	ctaHref?: string;
	logo?: string;
	logoAlt?: string;
	/** Social/contact/WhatsApp icons shown next to the CTA button. Defaults to configured social links + WhatsApp. */
	iconLinks?: IconLinkItem[];
}

const {
	ctaText = headerContent.cta.ctaText,
	ctaHref = headerContent.cta.ctaHref,
	logo = business.logo,
	logoAlt = business.name,
	iconLinks = getHeaderIconLinks(),
	backgroundColor,
	backgroundImage,
} = Astro.props;
const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<header class="header-cta" style={style}>
	<Container class="header-cta__inner">
		<a href="/" class="header-cta__brand">
			<BrandMark logo={logo} logoAlt={logoAlt} class="header-cta__logo" />
		</a>
		<nav class="header-cta__nav" aria-label="Navegación principal">
			<NavMenu items={mainNavigation} align="center" />
		</nav>
		<div class="header-cta__actions">
			<IconLinks items={iconLinks} size={18} class="header-cta__icon-links" />
			<Button href={ctaHref} size="sm">{ctaText}</Button>
		</div>
	</Container>
</header>

<style>
	.header-cta {
		position: relative;
	}

	:global(.header-cta__inner) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding-block: var(--spacing-sm);
	}

	.header-cta__brand {
		font-weight: bold;
		font-size: 1.25rem;
	}

	/* :global() because the `<img>` is now rendered by the `BrandMark` child component, which is outside this component's scoped-CSS boundary. */
	:global(.header-cta__logo) {
		height: 2.25rem;
		width: auto;
	}

	.header-cta__nav {
		flex: 1;
		display: flex;
		justify-content: center;
	}

	.header-cta__actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		flex-shrink: 0;
	}

	:global(.header-cta__icon-links) {
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		:global(.header-cta__icon-links) {
			display: none;
		}
	}
</style>
