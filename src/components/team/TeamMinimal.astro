---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { team, teamContent } from '../../config/teamContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
}

const {
	eyebrow = teamContent.minimal.eyebrow,
	title = teamContent.minimal.title,
	description = teamContent.minimal.description,
	backgroundColor,
	backgroundImage,
} = Astro.props;

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="team-minimal" style={style}>
	<Container>
		<div class="team-minimal__header">
			<SectionHeading
				eyebrow={eyebrow}
				title={title}
				description={description}
			/>
		</div>
		<ul class="team-minimal__rows">
			{team.map((member) => (
				<li class="team-minimal__row">
					<span class="team-minimal__name">{member.name}</span>
					<span class="team-minimal__role">{member.role}</span>
				</li>
			))}
		</ul>
	</Container>
</section>

<style>
	.team-minimal__header {
		max-width: 640px;
		margin-bottom: var(--spacing-md);
	}


	.team-minimal__rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.team-minimal__row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-block: var(--spacing-sm);
		border-bottom: 1px solid var(--color-border);
	}

	.team-minimal__name {
		font-weight: bold;
	}

	.team-minimal__role {
		color: var(--color-text-muted);
	}
</style>
