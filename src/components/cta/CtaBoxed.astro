---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { ctaContent } from '../../config/ctaContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	ctaText?: string;
	ctaHref?: string;
	secondaryCtaText?: string;
	secondaryCtaHref?: string;
	/** Background color/image applied to the inner box. The section itself stays transparent. */
	boxBackgroundColor?: string;
	boxBackgroundImage?: string;
	/** Any valid CSS length (e.g. "auto", "320px", "50vh"). */
	height?: string;
}

const {
	eyebrow = ctaContent.boxed.eyebrow,
	title = ctaContent.boxed.title,
	description = ctaContent.boxed.description,
	ctaText = ctaContent.boxed.ctaText,
	ctaHref = ctaContent.boxed.ctaHref,
	secondaryCtaText = ctaContent.boxed.secondaryCtaText,
	secondaryCtaHref = ctaContent.boxed.secondaryCtaHref,
	height = ctaContent.boxed.height,
	backgroundColor,
	backgroundImage,
	boxBackgroundColor = 'var(--color-primary)',
	boxBackgroundImage,
} = Astro.props;

const sectionStyle = backgroundStyle({ backgroundColor, backgroundImage }, { '--cta-boxed-height': height });
const boxStyle = backgroundStyle({ backgroundColor: boxBackgroundColor, backgroundImage: boxBackgroundImage });
---

<section class="cta-boxed" style={sectionStyle}>
	<Container>
		<div class="cta-boxed__box" style={boxStyle}>
			<SectionHeading
				eyebrow={eyebrow}
				eyebrowClass="cta-boxed__eyebrow"
				title={title}
				titleClass="cta-boxed__title"
				description={description}
				descriptionClass="cta-boxed__description"
			/>
			<div class="cta-boxed__actions">
				<Button href={ctaHref} variant="inverse" track="cta_click" trackLabel={ctaText}>{ctaText}</Button>
				{secondaryCtaText && <Button href={secondaryCtaHref} variant="inverse-outline">{secondaryCtaText}</Button>}
			</div>
		</div>
	</Container>
</section>

<style>
	.cta-boxed {
		width: 100%;
		min-height: var(--cta-boxed-height, auto);
		display: flex;
		align-items: center;
		padding-block: var(--spacing-xl);
	}

	.cta-boxed__box {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius-base) * 2);
		padding: var(--spacing-xl) var(--spacing-lg);
		background-color: var(--color-primary);
		color: var(--color-background);
		text-align: center;
	}

	/* :global() below because these are now rendered by the `SectionHeading` child component, outside this component's scoped-CSS boundary. */
	:global(.cta-boxed__eyebrow) {
		display: inline-block;
		margin-bottom: var(--spacing-xs);
		color: color-mix(in srgb, var(--color-background) 85%, transparent);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	:global(.cta-boxed__title) {
		color: var(--color-background);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
	}

	:global(.cta-boxed__description) {
		max-width: 560px;
		margin: var(--spacing-xs) auto 0;
		color: color-mix(in srgb, var(--color-background) 85%, transparent);
		font-size: 1.05rem;
	}

	.cta-boxed__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
	}
</style>
