---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CardImage from '../cards/CardImage.astro';
import { services, servicesContent, getServiceHref } from '../../config/servicesContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface ServicesShowcaseItem {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	href?: string;
	tag?: string;
	ctaText?: string;
}

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	ctaText?: string;
	/** When set, replaces the global `services` list. Omit to keep the starter content. */
	items?: ServicesShowcaseItem[];
}

const {
	eyebrow = servicesContent.showcase.eyebrow,
	title = servicesContent.showcase.title,
	description = servicesContent.showcase.description,
	ctaText = servicesContent.showcase.ctaText,
	items,
	backgroundColor,
	backgroundImage,
} = Astro.props;

const showcaseItems: ServicesShowcaseItem[] =
	items ??
	services.map((service) => ({
		title: service.title,
		description: service.description,
		image: service.image,
		imageAlt: service.title,
		href: getServiceHref(service),
		ctaText,
	}));

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="services-showcase" style={style}>
	<Container>
		<div class="services-showcase__header">
			<SectionHeading
				eyebrow={eyebrow}
				title={title}
				description={description}
			/>
		</div>
		<ul class="services-showcase__list">
			{showcaseItems.map((item) => (
				<li>
					<CardImage
						title={item.title}
						description={item.description}
						image={item.image}
						imageAlt={item.imageAlt}
						tag={item.tag}
						ctaText={item.ctaText}
						href={item.href}
					/>
				</li>
			))}
		</ul>
	</Container>
</section>

<style>
	.services-showcase__header {
		max-width: 640px;
		margin-bottom: var(--spacing-lg);
	}

	.services-showcase__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
		gap: var(--spacing-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
