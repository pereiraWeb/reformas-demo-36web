---
import { faqs, faqContent } from '../../config/faqContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';
import Container from '../ui/Container.astro';
import Accordion, { type AccordionItem } from '../ui/Accordion.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	/** When set, replaces the global FAQ list. Omit to keep the starter content. */
	items?: AccordionItem[];
}

const {
	eyebrow = faqContent.accordion.eyebrow,
	title = faqContent.accordion.title,
	description = faqContent.accordion.description,
	items = faqs,
	backgroundColor,
	backgroundImage,
} = Astro.props;

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="faq-accordion" style={style}>
	<Container>
		<div class="faq-accordion__header">
			<SectionHeading
				eyebrow={eyebrow}
				title={title}
				description={description}
			/>
		</div>
		<Accordion items={items} class="faq-accordion__list" />
	</Container>
</section>

<style>
	.faq-accordion__header {
		max-width: 640px;
		margin-bottom: var(--spacing-md);
	}

</style>
