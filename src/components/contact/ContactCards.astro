---
import Container from '../ui/Container.astro';
import CardIcon from '../cards/CardIcon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { ContactForm } from '../forms';
import { business } from '../../config/business';
import { contactContent } from '../../config/contactContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	submitText?: string;
}

const {
	eyebrow = contactContent.cards.eyebrow,
	title = contactContent.cards.title,
	description = contactContent.cards.description,
	submitText = contactContent.cards.submitText,
	backgroundColor,
	backgroundImage,
} = Astro.props;

const style = backgroundStyle({ backgroundColor, backgroundImage });
const infoCards = [
	{ icon: '@', title: contactContent.cards.emailLabel, description: business.email },
	{ icon: '#', title: contactContent.cards.phoneLabel, description: business.phone },
	{
		icon: '◎',
		title: contactContent.cards.addressLabel,
		description: `${business.address.street}, ${business.address.city}`,
	},
];
---

<section class="contact-cards" style={style}>
	<Container>
		<div class="contact-cards__header">
			<SectionHeading
				eyebrow={eyebrow}
				title={title}
				description={description}
			/>
		</div>
		<ul class="contact-cards__info">
			{infoCards.map((card) => (
				<li>
					<CardIcon title={card.title} description={card.description} icon={card.icon} />
				</li>
			))}
		</ul>
		<ContactForm class="contact-cards__form" submitText={submitText} />
	</Container>
</section>

<style>
	.contact-cards__header {
		max-width: 640px;
		margin-bottom: var(--spacing-lg);
	}


	.contact-cards__info {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--spacing-md);
		list-style: none;
		margin: 0 0 var(--spacing-lg);
		padding: 0;
	}

	:global(.contact-cards__form) {
		max-width: 480px;
	}

	:global(.contact-cards__submit) {
		align-self: flex-start;
	}
</style>
