---
import { business } from '../../config/business';

export interface Props {
	/**
	 * A more specific schema.org type when one applies, e.g.
	 * `"ProfessionalService"`, `"Restaurant"`, `"Store"`, `"Dentist"` — see
	 * https://schema.org/LocalBusiness for the full list of subtypes. Defaults
	 * to the generic `"LocalBusiness"`, which is always valid but less
	 * specific in rich results.
	 */
	type?: string;
	/** Optional price range shown in some rich results, e.g. `"€€"`. Omit if not meaningful for this business. */
	priceRange?: string;
}

const { type = 'LocalBusiness', priceRange } = Astro.props;

const DAY_ABBREVIATIONS: Record<string, string> = {
	monday: 'Mo',
	tuesday: 'Tu',
	wednesday: 'We',
	thursday: 'Th',
	friday: 'Fr',
	saturday: 'Sa',
	sunday: 'Su',
};

/** `"Monday - Friday"` -> `"Mo-Fr"`, `"Saturday"` -> `"Sa"`. Returns `null` (skipping this entry) rather than guessing at unrecognized formats, since invalid values fail rich-result validation. */
function toCompactDayRange(days: string): string | null {
	const abbreviations = days
		.split('-')
		.map((part) => DAY_ABBREVIATIONS[part.trim().toLowerCase()]);
	if (abbreviations.some((abbreviation) => !abbreviation)) return null;
	return abbreviations.join('-');
}

/** `"9:00 - 18:00"` -> `"09:00-18:00"`. Returns `null` on anything that doesn't match `H:MM`/`HH:MM`. */
function toCompactTimeRange(hours: string): string | null {
	const [start, end] = hours.split('-').map((part) => part.trim());
	const normalize = (time: string) => {
		const match = time.match(/^(\d{1,2}):(\d{2})$/);
		return match ? `${match[1].padStart(2, '0')}:${match[2]}` : null;
	};
	const normalizedStart = start ? normalize(start) : null;
	const normalizedEnd = end ? normalize(end) : null;
	return normalizedStart && normalizedEnd ? `${normalizedStart}-${normalizedEnd}` : null;
}

// Best-effort conversion of `business.hours` into schema.org's compact
// `openingHours` string format (e.g. `"Mo-Fr 09:00-18:00"`). Entries that
// don't parse cleanly are omitted entirely instead of emitting invalid data —
// double-check the result in Google's Rich Results Test after editing
// `business.hours`.
const openingHours = business.hours
	.map((entry) => {
		const days = toCompactDayRange(entry.days);
		const hours = toCompactTimeRange(entry.hours);
		return days && hours ? `${days} ${hours}` : null;
	})
	.filter((value): value is string => Boolean(value));

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': type,
	name: business.name,
	image: business.logo ? new URL(business.logo, business.siteUrl).toString() : undefined,
	url: business.siteUrl,
	telephone: business.phone,
	email: business.email,
	priceRange,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.address.street,
		addressLocality: business.address.city,
		addressRegion: business.address.region,
		postalCode: business.address.postalCode,
		addressCountry: business.address.country,
	},
	...(openingHours.length > 0 ? { openingHours } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
