---
import ResponsiveImage from '../media/ResponsiveImage.astro';
import { imageFallbacks } from '../../config/images';

export interface SocialLink {
	label: string;
	href: string;
}

export interface Props {
	name: string;
	role: string;
	image?: string;
	bio?: string;
	socialLinks?: SocialLink[];
}

const { name, role, image = imageFallbacks.photo, bio, socialLinks = [] } = Astro.props;
---

<article class="card-profile">
	<ResponsiveImage class="card-profile__avatar" src={image} alt={name} width={80} height={80} />
	<p class="card-profile__name">{name}</p>
	<p class="card-profile__role">{role}</p>
	{bio && <p class="card-profile__bio">{bio}</p>}
	{socialLinks.length > 0 && (
		<ul class="card-profile__social">
			{socialLinks.map((link) => (
				<li><a href={link.href}>{link.label}</a></li>
			))}
		</ul>
	)}
</article>

<style>
	.card-profile {
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		padding: var(--spacing-md);
		border-radius: var(--radius-base);
		border: 1px solid var(--color-border);
		background-color: var(--color-background);
		text-align: center;
	}

	/* :global() because the `<img>` is now rendered by the `ResponsiveImage` child component, which is outside this component's scoped-CSS boundary. */
	:global(.card-profile__avatar) {
		width: 5rem;
		height: 5rem;
		margin-bottom: var(--spacing-sm);
		border-radius: 50%;
		object-fit: cover;
	}

	.card-profile__name {
		margin: 0;
		font-weight: bold;
	}

	.card-profile__role {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.card-profile__bio {
		margin: var(--spacing-xs) 0 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.card-profile__social {
		display: flex;
		gap: var(--spacing-sm);
		list-style: none;
		margin: var(--spacing-sm) 0 0;
		padding: 0;
	}

	.card-profile__social a {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-primary);
	}
</style>
