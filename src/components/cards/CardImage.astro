---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ResponsiveImage from '../media/ResponsiveImage.astro';
import { imageFallbacks } from '../../config/images';

export interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	tag?: string;
	ctaText?: string;
	ctaHref?: string;
	/** Wraps the whole card in a link when provided, making the entire card clickable (not just the CTA text). */
	href?: string;
	/** Set on the one card whose image is the page's LCP candidate (rare — usually only relevant for the first card in a grid rendered above the fold). */
	priority?: boolean;
}

const {
	title,
	description,
	image = imageFallbacks.photo,
	imageAlt = title,
	tag,
	ctaText,
	ctaHref = '#',
	href,
	priority = false,
} = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class="card-image" href={href}>
	<div class="card-image__media">
		<ResponsiveImage src={image} alt={imageAlt} width={640} height={400} priority={priority} />
		{tag && <span class="card-image__tag">{tag}</span>}
	</div>
	<div class="card-image__body">
		<h3 class="card-image__title">{title}</h3>
		<p class="card-image__description">{description}</p>
		{ctaText && (href ? (
			<span class="card-image__cta card-image__cta--static" aria-hidden="true">
				{ctaText}
				<Icon name="arrow-right" size={16} />
			</span>
		) : (
			<Button href={ctaHref} variant="link" class="card-image__cta">
				{ctaText}
				<Icon name="arrow-right" size={16} />
			</Button>
		))}
	</div>
</Tag>

<style>
	.card-image {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: var(--radius-base);
		border: 1px solid var(--color-border);
		background-color: var(--color-background);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	a.card-image:hover {
		border-color: var(--color-primary);
		transform: translateY(-2px);
	}

	.card-image__media {
		position: relative;
		aspect-ratio: 16 / 10;
	}

	/* :global() because the `<img>` is now rendered by the `ResponsiveImage` child component, which is outside this component's scoped-CSS boundary. */
	:global(.card-image__media img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-image__tag {
		position: absolute;
		top: var(--spacing-xs);
		left: var(--spacing-xs);
		padding: 0.25rem 0.65rem;
		border-radius: 999px;
		background-color: var(--color-background);
		color: var(--color-text);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.card-image__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: var(--spacing-md);
	}

	.card-image__title {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
	}

	.card-image__description {
		margin: 0;
		color: var(--color-text-muted);
	}

	:global(.card-image__cta) {
		margin-top: var(--spacing-sm);
		align-self: flex-start;
	}

	.card-image__cta--static {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-primary);
		font-weight: 600;
		font-size: 0.9rem;
	}
</style>
