---
import Container from '../ui/Container.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import AgencyCredit from '../ui/AgencyCredit.astro';
import BrandMark from '../ui/BrandMark.astro';
import { business } from '../../config/business';
import { mainNavigation, legalNavigation } from '../../config/navigation';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	logo?: string;
	logoAlt?: string;
}

const {
	logo = business.logo,
	logoAlt = business.name,
	backgroundColor,
	backgroundImage,
} = Astro.props;
const style = backgroundStyle({ backgroundColor, backgroundImage });
const year = new Date().getFullYear();
const socialLinks = Object.entries(business.social).filter(([, href]) => href);
---

<footer class="footer-centered" style={style}>
	<Container class="footer-centered__inner">
		<a href="/" class="footer-centered__brand">
			<BrandMark logo={logo} logoAlt={logoAlt} class="footer-centered__logo" />
		</a>
		<nav aria-label="Navegación principal">
			<ul>
				{mainNavigation.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</nav>
		{socialLinks.length > 0 && (
			<ul class="footer-centered__social">
				{socialLinks.map(([label, href]) => (
					<li>
						<a href={href} aria-label={label}>
							<Icon name={label as IconName} />
						</a>
					</li>
				))}
			</ul>
		)}
		<p class="footer-centered__copyright">&copy; {year} {business.legalName}. All rights reserved.</p>
		<ul class="footer-centered__legal">
			{legalNavigation.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
		<AgencyCredit />
	</Container>
</footer>

<style>
	.footer-centered {
		border-top: 1px solid var(--color-border);
		background-color: var(--color-surface);
		text-align: center;
	}

	:global(.footer-centered__inner) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-sm);
		padding-block: var(--spacing-lg);
	}

	.footer-centered__brand {
		display: inline-flex;
		font-weight: bold;
		font-size: 1.25rem;
	}

	/* :global() because the `<img>` is now rendered by the `BrandMark` child component, which is outside this component's scoped-CSS boundary. */
	:global(.footer-centered__logo) {
		height: 2.25rem;
		width: auto;
	}

	:global(.footer-centered__inner) ul {
		display: flex;
		justify-content: center;
		gap: var(--spacing-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-centered__social a {
		display: inline-flex;
		color: var(--color-text-muted);
	}

	.footer-centered__social a:hover {
		color: var(--color-primary);
	}

	.footer-centered__copyright {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.footer-centered__legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-sm);
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.85rem;
	}

	.footer-centered__legal a {
		color: var(--color-text-muted);
	}
</style>
